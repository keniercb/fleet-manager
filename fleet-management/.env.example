# ============================================================================
# .env.example — Variables de entorno para docker-compose
# ============================================================================
# Copiar a .env y completar con valores reales:
#   cp .env.example .env
#   # editar .env con un editor
#
# NUNCA commitear el archivo .env con secretos reales.
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=fleetdb
POSTGRES_USER=fleet_user
POSTGRES_PASSWORD=cambia_esta_password_por_una_segura

# ---------------------------------------------------------------------------
# Spring Boot — secretos obligatorios (la app NO arranca sin estos)
# ---------------------------------------------------------------------------
# JWT secret: cadena aleatoria de al menos 64 caracteres hex.
# Generar con: openssl rand -hex 32
JWT_SECRET=genera_un_secret_aleatorio_de_64_chars_aqui

# Password del usuario admin inicial creado por DataInitializer
FLEET_DEFAULT_ADMIN_PASSWORD=CambiaEstaPassword2026#

# ---------------------------------------------------------------------------
# Enzona (Pagos QR) — opcionales si el módulo de pagos no está activo
# ---------------------------------------------------------------------------
# Si no se configuran, el módulo de pagos fallará al crear QRs pero la app arranca.
ENZONA_CLIENT_ID=
ENZONA_CLIENT_SECRET=
ENZONA_MERCHANT_UUID=
ENZONA_NOTIFY_URL=
ENZONA_RETURN_URL=

# Whitelist de IPs de Enzona para validar webhook (separadas por coma)
# Si vacío, la validación de IP se omite (NO recomendado en prod)
ENZONA_ALLOWED_IPS=

# Secreto compartido para validar firma HMAC-SHA256 del webhook
# Generar con: openssl rand -hex 32
ENZONA_WEBHOOK_SECRET=
