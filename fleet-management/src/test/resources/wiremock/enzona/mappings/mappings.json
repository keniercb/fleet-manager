        }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "access_token": "test-access-token-1234567890",
          "token_type": "bearer",
          "expires_in": 3600
        }
      }
    },
